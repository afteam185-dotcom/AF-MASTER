[debug] [2026-11-14T19:04:12.991Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-af-master:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n    function isAdmin() {\r\n      return signedIn()\r\n        && request.auth.token.firebase.sign_in_provider == 'google.com'\r\n        && request.auth.uid in [\r\n          'J9BuDGBCXTced8WtkJsjDQUw94g2',\r\n          'BrequkkRPuRVaLgmlN8i8tMmN7I2',\r\n          'ePEzd3F1BNXJvwteHU2TqTYshMq2'  \r\n        ];\r\n    }\r\n    function hasActiveProfile() {\r\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isActive == true;\r\n    }\r\n    function hasLearningAccess() {\r\n      return hasActiveProfile()\r\n        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('whatsappShareCount', 0) >= 10;\r\n    }\r\n    function matchesCourseGrade(course, student) {\r\n      return course.keys().hasAny(['grade'])\r\n        && (course.grade == student.grade\r\n          || (course.grade is list && course.grade.hasAny([student.grade])));\r\n    }\r\n    function matchesCourseTrack(course, student) {\r\n      return course.keys().hasAny(['track'])\r\n        && (course.track == student.track\r\n          || course.track == 'كلاهما'\r\n          || (course.track is list && course.track.hasAny([student.track, 'كلاهما'])));\r\n    }\r\n    function matchesCourseAudience(course, student) {\r\n      return course.keys().hasAny(['audienceKeys'])\r\n        && course.audienceKeys is list\r\n        && course.audienceKeys.hasAny([student.grade + '|' + student.track]);\r\n    }\r\n    function matchesStudentCourse(course) {\r\n      let student = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;\r\n      return hasLearningAccess()\r\n        && matchesCourseAudience(course, student);\r\n    }\r\n    function isSelf(uid) {\r\n      return signedIn() && request.auth.uid == uid;\r\n    }\r\n    function validAdminStudentStatusUpdate(uid) {\r\n      return isAdmin()\r\n        && !(uid in [\r\n          'J9BuDGBCXTced8WtkJsjDQUw94g2',\r\n          'BrequkkRPuRVaLgmlN8i8tMmN7I2',\r\n          'ePEzd3F1BNXJvwteHU2TqTYshMq2'\r\n        ])\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          'isActive', 'statusUpdatedAt'\r\n        ])\r\n        && request.resource.data.isActive is bool\r\n        && request.resource.data.statusUpdatedAt == request.time;\r\n    }\r\n    function validMessageExpiry(value) {\r\n      return value is timestamp\r\n        && value > request.time\r\n        && value <= request.time + duration.value(25, 'h');\r\n    }\r\n    function validChatMessageFields() {\r\n      return request.resource.data.keys().hasAll([\r\n          'senderId', 'senderName', 'text', 'kind', 'createdAt', 'expiresAt'\r\n        ])\r\n        && request.resource.data.keys().hasOnly([\r\n          'senderId', 'senderName', 'text', 'kind', 'createdAt', 'expiresAt'\r\n        ])\r\n        && request.resource.data.senderId is string\r\n        && request.resource.data.senderName is string\r\n        && request.resource.data.text is string\r\n        && request.resource.data.text.size() > 0\r\n        && request.resource.data.text.size() <= 2000\r\n        && request.resource.data.createdAt == request.time;\r\n    }\r\n    function validSupportMessageSummary(roomId, messageId, senderId, senderName, messageText, senderKind) {\r\n      return roomId.matches('^support_[A-Za-z0-9_-]+$')\r\n        && existsAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId))\r\n        && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data.senderId == senderId\r\n        && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data.senderName == senderName\r\n        && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data.text == messageText\r\n        && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data.kind == senderKind\r\n        && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data.createdAt == request.time\r\n        && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data.expiresAt == null;\r\n    }\r\n    function validChatMessage(roomId, messageId) {\r\n      return validChatMessageFields()\r\n        && (\r\n          (\r\n            isAdmin()\r\n            && request.resource.data.senderId == request.auth.uid\r\n            && request.resource.data.senderName == 'مشرف AF MASTER'\r\n            && request.resource.data.kind == 'admin'\r\n            && (\r\n              (\r\n                roomId == 'students'\r\n                && validMessageExpiry(request.resource.data.expiresAt)\r\n              )\r\n              || (\r\n                roomId.matches('^support_[A-Za-z0-9_-]+$')\r\n                && request.resource.data.expiresAt == null\r\n                && exists(/databases/$(database)/documents/chatRooms/$(roomId))\r\n                && roomId == 'support_' + getAfter(\r\n                  /databases/$(database)/documents/chatRooms/$(roomId)\r\n                ).data.studentUid\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.awaitingAdminReply == false\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.adminReplyAt == request.time\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.latestSenderId == request.auth.uid\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.lastMessageId == messageId\r\n                && validSupportMessageSummary(roomId, messageId, request.auth.uid,\r\n                  'مشرف AF MASTER', request.resource.data.text, 'admin')\r\n              )\r\n            )\r\n          )\r\n          || (\r\n            hasActiveProfile()\r\n            && request.resource.data.senderId == request.auth.uid\r\n            && request.resource.data.senderName\r\n              == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.fullName\r\n            && request.resource.data.kind == 'student'\r\n            && (\r\n              (\r\n                roomId == 'students'\r\n                && validMessageExpiry(request.resource.data.expiresAt)\r\n              )\r\n              || (\r\n                roomId == 'support_' + request.auth.uid\r\n                && request.resource.data.expiresAt == null\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.studentUid == request.auth.uid\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.awaitingAdminReply == true\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.adminReplyAt == null\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.latestSenderId == request.auth.uid\r\n                && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.lastMessageId == messageId\r\n                && validSupportMessageSummary(roomId, messageId, request.auth.uid,\r\n                  get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.fullName,\r\n                  request.resource.data.text, 'student')\r\n              )\r\n            )\r\n          )\r\n          || (\r\n            hasActiveProfile()\r\n            && roomId == 'support_' + request.auth.uid\r\n            && request.resource.data.senderId == 'system'\r\n            && request.resource.data.senderName == 'AF MASTER'\r\n            && request.resource.data.text == 'تم استلام رسالتك، وسيتم الرد عليك خلال 24 ساعة.'\r\n            && request.resource.data.kind == 'system'\r\n            && request.resource.data.expiresAt == null\r\n            && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.studentUid == request.auth.uid\r\n            && getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data.awaitingAdminReply == true\r\n          )\r\n        );\r\n    }\r\n    function validSupportRoom(roomId) {\r\n      return request.resource.data.keys().hasAll([\r\n          'roomType', 'studentUid', 'updatedAt', 'awaitingAdminReply',\r\n          'adminReplyAt', 'latestMessage', 'latestMessageAt',\r\n          'latestSenderId', 'latestSenderName', 'lastMessageId'\r\n        ])\r\n        && request.resource.data.keys().hasOnly([\r\n          'roomType', 'studentUid', 'updatedAt', 'awaitingAdminReply',\r\n          'adminReplyAt', 'latestMessage', 'latestMessageAt',\r\n          'latestSenderId', 'latestSenderName', 'lastMessageId'\r\n        ])\r\n        && request.resource.data.roomType == 'support'\r\n        && request.resource.data.studentUid is string\r\n        && roomId == 'support_' + request.resource.data.studentUid\r\n        && request.resource.data.updatedAt == request.time\r\n        && request.resource.data.awaitingAdminReply is bool\r\n        && request.resource.data.latestMessage is string\r\n        && request.resource.data.latestMessage.size() > 0\r\n        && request.resource.data.latestMessage.size() <= 2000\r\n        && request.resource.data.latestMessageAt == request.time\r\n        && (request.resource.data.adminReplyAt == null\r\n          || request.resource.data.adminReplyAt is timestamp)\r\n        && request.resource.data.latestSenderId is string\r\n        && request.resource.data.latestSenderName is string\r\n        && request.resource.data.lastMessageId is string\r\n        && (\r\n          (\r\n            isAdmin()\r\n            && exists(/databases/$(database)/documents/profiles/$(request.resource.data.studentUid))\r\n            && request.resource.data.awaitingAdminReply == false\r\n            && request.resource.data.adminReplyAt == request.time\r\n            && request.resource.data.latestSenderId == request.auth.uid\r\n            && request.resource.data.latestSenderName == 'مشرف AF MASTER'\r\n            && validSupportMessageSummary(roomId, request.resource.data.lastMessageId,\r\n              request.auth.uid, 'مشرف AF MASTER', request.resource.data.latestMessage, 'admin')\r\n            && (!exists(/databases/$(database)/documents/chatRooms/$(roomId))\r\n              || resource.data.studentUid == request.resource.data.studentUid)\r\n          )\r\n          || (\r\n            hasActiveProfile()\r\n            && request.resource.data.studentUid == request.auth.uid\r\n            && request.resource.data.awaitingAdminReply == true\r\n            && request.resource.data.adminReplyAt == null\r\n            && request.resource.data.latestSenderId == request.auth.uid\r\n            && request.resource.data.latestSenderName\r\n              == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.fullName\r\n            && validSupportMessageSummary(roomId, request.resource.data.lastMessageId,\r\n              request.auth.uid, request.resource.data.latestSenderName,\r\n              request.resource.data.latestMessage, 'student')\r\n            && (!exists(/databases/$(database)/documents/chatRooms/$(roomId))\r\n              || resource.data.studentUid == request.auth.uid)\r\n          )\r\n        );\r\n    }\r\n    function validStudentLoginCode(uid) {\r\n      let code = getAfter(\r\n        /databases/$(database)/documents/profiles/$(uid)/privateAuth/login\r\n      ).data.loginCode;\r\n      return code is string\r\n        && code.matches('^[0-9]{24}$')\r\n        && existsAfter(/databases/$(database)/documents/loginCodes/$(code))\r\n        && getAfter(/databases/$(database)/documents/loginCodes/$(code)).data.uid == uid;\r\n    }\r\n    function validStudentProfile(uid) {\r\n      return isSelf(uid)\r\n        && request.auth.token.firebase.sign_in_provider == 'google.com'\r\n        && !(uid in [\r\n          'J9BuDGBCXTced8WtkJsjDQUw94g2',\r\n          'BrequkkRPuRVaLgmlN8i8tMmN7I2',\r\n          'ePEzd3F1BNXJvwteHU2TqTYshMq2'\r\n        ])\r\n        && request.resource.data.keys().hasAll([\r\n          'uid', 'fullName', 'normalizedName', 'email', 'phone', 'grade', 'track',\r\n          'studentCode', 'referredByUid', 'referralCodeUsed', 'isActive',\r\n          'referralCount', 'whatsappShareCount', 'whatsappChannelJoined',\r\n          'lastWhatsAppShareId', 'createdAt'\r\n        ])\r\n        && request.resource.data.keys().hasOnly([\r\n          'uid', 'fullName', 'normalizedName', 'email', 'phone', 'grade', 'track',\r\n          'studentCode', 'referredByUid', 'referralCodeUsed', 'isActive',\r\n          'referralCount', 'whatsappShareCount', 'whatsappChannelJoined',\r\n          'lastWhatsAppShareId', 'createdAt'\r\n        ])\r\n        && request.resource.data.uid == uid\r\n        && request.resource.data.fullName is string\r\n        && request.resource.data.fullName.size() >= 8\r\n        && request.resource.data.fullName.size() <= 100\r\n        && request.resource.data.fullName.matches('^\\\\S+( \\\\S+){2,}$')\r\n        && !request.resource.data.fullName.matches('.*/.*')\r\n        && request.resource.data.normalizedName == request.resource.data.fullName.lower()\r\n        && request.resource.data.email is string\r\n        && request.resource.data.email == request.auth.token.email\r\n        && request.resource.data.phone.matches('^\\\\+?[0-9]{8,15}$')\r\n        && request.resource.data.grade in ['الأول الثانوي', 'الثاني الثانوي', 'الثالث الثانوي']\r\n        && request.resource.data.track in ['عربي', 'لغات']\r\n        && request.resource.data.studentCode.matches('^AF[A-F0-9]{8}$')\r\n        && request.resource.data.isActive == true\r\n        && request.resource.data.referralCount == 0\r\n        && request.resource.data.whatsappShareCount == 0\r\n        && request.resource.data.whatsappChannelJoined == false\r\n        && request.resource.data.lastWhatsAppShareId == null\r\n        && request.resource.data.createdAt == request.time\r\n        && existsAfter(/databases/$(database)/documents/phoneNumbers/$(request.resource.data.phone))\r\n        && getAfter(/databases/$(database)/documents/phoneNumbers/$(request.resource.data.phone)).data.uid == uid\r\n        && existsAfter(/databases/$(database)/documents/profileNames/$(request.resource.data.normalizedName))\r\n        && getAfter(/databases/$(database)/documents/profileNames/$(request.resource.data.normalizedName)).data.uid == uid\r\n        && existsAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.studentCode))\r\n        && getAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.studentCode)).data.uid == uid\r\n        && validStudentLoginCode(uid)\r\n        && (\r\n          (request.resource.data.referredByUid == null && request.resource.data.referralCodeUsed == null)\r\n          || (\r\n            request.resource.data.referredByUid is string\r\n            && request.resource.data.referredByUid != uid\r\n            && request.resource.data.referralCodeUsed is string\r\n            && request.resource.data.referralCodeUsed.matches('^AF[A-F0-9]{8}$')\r\n            && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCodeUsed)).data.uid\r\n              == request.resource.data.referredByUid\r\n          )\r\n        );\r\n    }\r\n    function validReferralIncrement(uid) {\r\n      return signedIn()\r\n        && request.auth.uid != uid\r\n        && resource.data.isActive == true\r\n        && request.resource.data.diff