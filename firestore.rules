rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasCurrentDevice() {
      return signedIn()
        && request.auth.token.deviceSession is string
        && exists(/databases/$(database)/documents/devices/$(request.auth.uid)/sessions/$(request.auth.token.deviceSession))
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)/sessions/$(request.auth.token.deviceSession)).data.active == true;
    }
    function isAdmin() {
      return hasCurrentDevice()
        && request.auth.token.admin == true
        && request.auth.uid in [
          'J9BuDGBCXTced8WtkJsjDQUw94g2',
          'BrequkkRPuRVaLgmlN8i8tMmN7I2',
          'ePEzd3F1BNXJvwteHU2TqTYshMq2'
        ];
    }
    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isActive == true;
    }
    function hasLearningAccess() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('whatsappShareCount', 0) >= 10;
    }
    function matchesStudentCourse(course) {
      return hasLearningAccess()
        && course.grade == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.grade
        && course.track == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.track;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validStudentProfile(uid) {
      return isSelf(uid)
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && !(uid in [
          'J9BuDGBCXTced8WtkJsjDQUw94g2',
          'BrequkkRPuRVaLgmlN8i8tMmN7I2',
          'ePEzd3F1BNXJvwteHU2TqTYshMq2'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'normalizedName', 'email', 'phone', 'grade', 'track',
          'studentCode', 'referredByUid', 'referralCodeUsed', 'isActive',
          'referralCount', 'whatsappShareCount', 'lastWhatsAppShareId', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'normalizedName', 'email', 'phone', 'grade', 'track',
          'studentCode', 'referredByUid', 'referralCodeUsed', 'isActive',
          'referralCount', 'whatsappShareCount', 'lastWhatsAppShareId', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 8
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.fullName.matches('^\\S+( \\S+){2,}$')
        && !request.resource.data.fullName.matches('.*/.*')
        && request.resource.data.normalizedName == request.resource.data.fullName.lower()
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone.matches('^\\+?[0-9]{8,15}$')
        && request.resource.data.grade in ['الأول الثانوي', 'الثاني الثانوي', 'الثالث الثانوي']
        && request.resource.data.track in ['عربي', 'لغات']
        && request.resource.data.studentCode.matches('^AF[A-F0-9]{8}$')
        && request.resource.data.isActive == true
        && request.resource.data.referralCount == 0
        && request.resource.data.whatsappShareCount == 0
        && request.resource.data.lastWhatsAppShareId == null
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/phoneNumbers/$(request.resource.data.phone))
        && getAfter(/databases/$(database)/documents/phoneNumbers/$(request.resource.data.phone)).data.uid == uid
        && existsAfter(/databases/$(database)/documents/profileNames/$(request.resource.data.normalizedName))
        && getAfter(/databases/$(database)/documents/profileNames/$(request.resource.data.normalizedName)).data.uid == uid
        && existsAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.studentCode))
        && getAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.studentCode)).data.uid == uid
        && (
          (request.resource.data.referredByUid == null && request.resource.data.referralCodeUsed == null)
          || (
            request.resource.data.referredByUid is string
            && request.resource.data.referredByUid != uid
            && request.resource.data.referralCodeUsed is string
            && request.resource.data.referralCodeUsed.matches('^AF[A-F0-9]{8}$')
            && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCodeUsed)).data.uid
              == request.resource.data.referredByUid
          )
        );
    }
    function validReferralIncrement(uid) {
      return signedIn()
        && request.auth.uid != uid
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount'])
        && request.resource.data.referralCount == resource.data.referralCount + 1
        && existsAfter(/databases/$(database)/documents/profiles/$(uid)/referrals/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(uid)/referrals/$(request.auth.uid)).data.referredUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.referredByUid == uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.referralCodeUsed == resource.data.studentCode
        && get(/databases/$(database)/documents/referralCodes/$(resource.data.studentCode)).data.uid == uid;
    }
    function validWhatsAppShareIncrement(uid) {
      return isSelf(uid)
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'whatsappShareCount', 'lastWhatsAppShareId'
        ])
        && request.resource.data.whatsappShareCount == resource.data.get('whatsappShareCount', 0) + 1
        && request.resource.data.lastWhatsAppShareId is string
        && request.resource.data.lastWhatsAppShareId.matches('^[a-f0-9]{64}$')
        && existsAfter(/databases/$(database)/documents/profiles/$(uid)/whatsappShares/$(request.resource.data.lastWhatsAppShareId))
        && getAfter(/databases/$(database)/documents/profiles/$(uid)/whatsappShares/$(request.resource.data.lastWhatsAppShareId)).data.recipientHash
          == request.resource.data.lastWhatsAppShareId
        && getAfter(/databases/$(database)/documents/profiles/$(uid)/whatsappShares/$(request.resource.data.lastWhatsAppShareId)).data.createdAt
          == request.time;
    }

    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validStudentProfile(uid);
      allow update: if (isSelf(uid)
          && resource.data.isActive == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade', 'track'])
          && request.resource.data.grade in ['الأول الثانوي', 'الثاني الثانوي', 'الثالث الثانوي']
          && request.resource.data.track in ['عربي', 'لغات'])
        || validReferralIncrement(uid)
        || validWhatsAppShareIncrement(uid);
      allow delete: if false;
      match /referrals/{referralUid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if signedIn()
          && request.auth.uid == referralUid
          && request.resource.data.keys().hasOnly(['referredUid', 'referralCode', 'createdAt'])
          && request.resource.data.referredUid == referralUid
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/profiles/$(referralUid)).data.referredByUid == uid
          && getAfter(/databases/$(database)/documents/profiles/$(referralUid)).data.referralCodeUsed == request.resource.data.referralCode
          && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.uid == uid;
        allow update, delete: if false;
      }
      match /warnings/{warningId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /whatsappShares/{shareId} {
        allow get: if isSelf(uid) || isAdmin();
        allow list: if false;
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['recipientHash', 'createdAt'])
          && shareId.matches('^[a-f0-9]{64}$')
          && request.resource.data.recipientHash == shareId
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.lastWhatsAppShareId == shareId
          && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.whatsappShareCount
            == get(/databases/$(database)/documents/profiles/$(uid)).data.get('whatsappShareCount', 0) + 1;
        allow update, delete: if false;
      }
    }

    match /courses/{courseId} {
      allow read: if isAdmin() || matchesStudentCourse(resource.data);
      allow write: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if isAdmin() || matchesStudentCourse(resource.data);
      allow write: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read: if isAdmin()
        || (roomId == 'students' && hasActiveProfile())
        || (roomId == 'support_' + request.auth.uid && hasActiveProfile());
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isAdmin()
          || ((roomId == 'students' || roomId == 'support_' + request.auth.uid)
            && hasActiveProfile()
            && (resource.data.expiresAt == null || resource.data.expiresAt > request.time));
        allow write: if false;
      }
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || (hasActiveProfile() && resource.data.expiresAt > request.time);
      allow write: if isAdmin();
      match /seen/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && hasActiveProfile()
          && request.resource.data.keys().hasOnly(['seenAt']);
        allow update, delete: if false;
      }
    }

    match /devices/{uid}/sessions/{deviceId} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /phoneNumbers/{phone} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/phoneNumbers/$(phone))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.phone == phone;
      allow update, delete: if false;
    }
    match /profileNames/{nameKey} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/profileNames/$(nameKey))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.normalizedName == nameKey;
      allow update, delete: if false;
    }
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/referralCodes/$(code))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.studentCode == code;
      allow update, delete: if false;
    }
    match /deviceRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
